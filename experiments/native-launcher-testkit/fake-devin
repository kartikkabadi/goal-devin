#!/usr/bin/env python3
"""Deterministic fake `devin` used by the native launcher black-box testkit.

Records its invocation environment, verifies the Goal Devin generated profile
and hook, invokes the observation hook, and exits without network access.
"""

import concurrent.futures
import json
import os
import shlex
import stat
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

MAX_STDIN_BYTES = 1024 * 1024

DEFAULT_EXIT_CODE = 0
DEFAULT_SLEEP = 0.2
DOCUMENTED_FIELDS = {"name", "description", "model", "allowed-tools", "permissions"}


def _now() -> str:
    return datetime.now(timezone.utc).isoformat()


def _lifecycle_log(label: str) -> None:
    path = os.environ.get("GOAL_DEVIN_LIFECYCLE_LOG")
    if not path:
        return
    p = Path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    with open(p, "a", encoding="utf-8") as fh:
        fh.write(f"{label} {_now()}\n")
        fh.flush()


def _load_runtime_dir() -> Path | None:
    value = os.environ.get("GOAL_DEVIN_RUNTIME_DIR")
    return Path(value) if value else None


def _record(runtime_dir: Path, data: dict) -> None:
    if runtime_dir is None:
        return
    runtime_dir.mkdir(parents=True, exist_ok=True)
    record_path = runtime_dir / "fake-devin.record.json"
    record_path.write_text(json.dumps(data, indent=2), encoding="utf-8")
    os.chmod(record_path, 0o600)


def _write_pid(runtime_dir: Path | None) -> None:
    if runtime_dir is None:
        return
    pid_path = runtime_dir / "child.pid"
    pid_path.write_text(str(os.getpid()), encoding="utf-8")
    os.chmod(pid_path, 0o600)


def _barrier_wait(runtime_dir: Path | None, timeout: float = 30.0) -> None:
    if runtime_dir is None:
        return
    if not os.environ.get("GOAL_DEVIN_BARRIER"):
        return
    continue_path = runtime_dir / "continue"
    deadline = time.monotonic() + timeout
    while not continue_path.exists():
        if time.monotonic() > deadline:
            raise RuntimeError("Barrier release not received within timeout")
        time.sleep(0.01)


def _find_profile(canary: Path) -> tuple[Path, dict] | None:
    agents_dir = canary / ".devin" / "agents"
    if not agents_dir.is_dir():
        return None
    for entry in agents_dir.iterdir():
        if entry.is_dir() and entry.name.startswith("goal-devin-worker-"):
            agent_file = entry / "AGENT.md"
            if agent_file.exists():
                frontmatter = _parse_frontmatter(agent_file.read_text(encoding="utf-8"))
                return agent_file, frontmatter
    return None


def _coerce(value: str) -> str | int | float | bool:
    """Coerce a scalar YAML value."""
    value = value.strip()
    if (value.startswith('"') and value.endswith('"')) or (
        value.startswith("'") and value.endswith("'")
    ):
        return value[1:-1]
    lowered = value.lower()
    if lowered in ("true", "yes"):
        return True
    if lowered in ("false", "no"):
        return False
    if lowered in ("null", "~"):
        return None
    try:
        return int(value)
    except ValueError:
        pass
    try:
        return float(value)
    except ValueError:
        pass
    return value


def _parse_yaml(lines: list[str], idx: int = 0, base_indent: int = 0) -> tuple[Any, int]:
    """Parse a small subset of YAML into nested dicts and lists."""
    container_type: str | None = None
    result: Any = None
    while idx < len(lines):
        raw = lines[idx]
        if not raw.strip() or raw.strip().startswith("#"):
            idx += 1
            continue
        indent = len(raw) - len(raw.lstrip())
        if indent < base_indent:
            break
        if indent > base_indent:
            idx += 1
            continue
        stripped = raw.strip()
        if stripped.startswith("- "):
            if container_type is None:
                container_type = "list"
                result = []
            value = stripped[2:].strip()
            if ":" in value:
                key, _, rest = value.partition(":")
                key = key.strip()
                rest = rest.strip()
                if rest == "":
                    child, idx = _parse_yaml(lines, idx + 1, indent + 2)
                    result.append({key: child})
                else:
                    result.append({key: _coerce(rest)})
            else:
                result.append(_coerce(value))
            idx += 1
        else:
            if container_type is None:
                container_type = "dict"
                result = {}
            key, _, value = stripped.partition(":")
            key = key.strip()
            value = value.strip()
            if value == "":
                child, idx = _parse_yaml(lines, idx + 1, indent + 2)
                result[key] = child
            else:
                result[key] = _coerce(value)
                idx += 1
    return result, idx


def _parse_frontmatter(text: str) -> dict:
    lines = text.splitlines()
    if lines and lines[0].strip() == "---":
        try:
            end = lines[1:].index("---") + 1
        except ValueError:
            end = len(lines)
        yaml_block = "\n".join(lines[1:end])
        parsed, _ = _parse_yaml(yaml_block.splitlines(), 0, 0)
        return parsed if isinstance(parsed, dict) else {}
    return {}


def _verify_profile(canary: Path, expected_model: str) -> str:
    found = _find_profile(canary)
    if found is None:
        raise RuntimeError("No Goal Devin worker profile found in .devin/agents")
    path, front = found
    unknown = set(front.keys()) - DOCUMENTED_FIELDS
    if unknown:
        raise RuntimeError(f"Profile contains unsupported frontmatter keys: {unknown}")
    profile_id = path.parent.name
    if front.get("name") != profile_id:
        raise RuntimeError(
            f"Profile name mismatch: directory {profile_id!r} != frontmatter {front.get('name')!r}"
        )
    if front.get("model") != expected_model:
        raise RuntimeError(
            f"Profile model mismatch: expected {expected_model}, got {front.get('model')}"
        )
    agent_mode = stat.S_IMODE(path.stat().st_mode)
    if agent_mode != 0o600:
        raise RuntimeError(f"AGENT.md mode is {oct(agent_mode)}, expected 0o600")
    allowed = front.get("allowed-tools", [])
    if set(allowed) != {"read", "grep", "glob"}:
        raise RuntimeError(f"Profile allowed-tools is not read-only: {allowed}")
    permissions = front.get("permissions", {})
    deny = permissions.get("deny", []) if isinstance(permissions, dict) else []
    if set(deny) != {"write", "edit"}:
        raise RuntimeError(f"Profile does not deny write/edit: {deny}")
    return profile_id


def _find_hook_command(canary: Path) -> list[str] | None:
    hooks_file = canary / ".devin" / "hooks.v1.json"
    if not hooks_file.exists():
        return None
    config = json.loads(hooks_file.read_text(encoding="utf-8"))
    for event in ("PostToolUse", "PreToolUse"):
        entries = config.get(event, [])
        for entry in entries:
            for hook in entry.get("hooks", []):
                if hook.get("type") == "command":
                    command = hook.get("command")
                    if command:
                        return shlex.split(command)
    return None


def _verify_existing_hooks_preserved(canary: Path) -> None:
    expected = os.environ.get("GOAL_DEVIN_EXPECTED_EXISTING_HOOK_COMMAND")
    if not expected:
        return
    hooks_file = canary / ".devin" / "hooks.v1.json"
    if not hooks_file.exists():
        raise RuntimeError("Existing hooks fixture not present at run time")
    if expected not in hooks_file.read_text(encoding="utf-8"):
        raise RuntimeError(f"Existing hook command was not preserved: {expected}")


def _invoke_hook(
    command: list[str],
    profile_id: str,
    event_name: str = "PostToolUse",
) -> int:
    payload: dict[str, Any] = {
        "hook_event_name": event_name,
        "tool_name": "run_subagent",
        "tool_input": {
            "title": "<redacted>",
            "task": "<redacted>",
            "profile": profile_id,
            "is_background": False,
        },
    }
    if event_name == "PostToolUse":
        payload["tool_response"] = {"success": True, "output": "<redacted>"}
    else:
        payload["tool_response"] = {}
    proc = subprocess.run(
        command,
        input=json.dumps(payload).encode("utf-8"),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
    )
    return proc.returncode


def _canonical_flood(command: list[str], profile_id: str, count: int) -> None:
    """Emit *count* canonical PostToolUse/run_subagent events through the hook."""
    for _ in range(max(count, 0)):
        _invoke_hook(command, profile_id, event_name="PostToolUse")


def _read_limits(runtime_dir: Path) -> dict[str, int]:
    """Read the runtime limits, falling back to safe defaults."""
    defaults: dict[str, int] = {
        "max_tool_name_length": 128,
        "max_profile_length": 128,
        "max_event_value_length": 256,
        "max_event_json_bytes": 4096,
        "max_total_spool_bytes": 1024 * 1024,
        "max_retained_event_files": 100,
        "max_distinct_tools": 50,
        "max_distinct_profiles": 50,
        "max_recent_event_ids": 20,
        "max_summary_size_bytes": 64 * 1024,
    }
    try:
        data = json.loads((runtime_dir / "limits.json").read_text(encoding="utf-8"))
        if isinstance(data, dict):
            for key, value in data.items():
                if isinstance(value, int) and not isinstance(value, bool) and value >= 1:
                    defaults[key] = value
    except (OSError, json.JSONDecodeError, ValueError):
        pass
    return defaults


def _atomic_write_event(events_dir: Path, event_id: str, event: dict) -> Path:
    """Atomically write a single event JSON file."""
    directory = events_dir
    directory.mkdir(parents=True, exist_ok=True)
    data = json.dumps(event, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=f"{event_id}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, 0o600)
        final = directory / f"{event_id}.json"
        os.rename(tmp, final)
        return final
    except Exception:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise


def _stress_event_id(prefix: str, idx: int) -> str:
    return f"{prefix}-{idx:08d}-{os.urandom(4).hex()}"


def _stress_emit_events(runtime_dir: Path, canary: Path, profile_id: str, limits: dict[str, int]) -> None:
    """Emit a controlled burst of valid/invalid spool files to exercise the sidecar bounds."""
    events_dir = runtime_dir / "events"
    now = _now()

    def make_event(i: int, num_tools: int, num_profiles: int) -> dict:
        return {
            "schema_version": 1,
            "event": "PostToolUse",
            "tool_name": f"tool-{i % num_tools}",
            "profile": f"profile-{i % num_profiles}",
            "is_background": False,
            "success": True,
            "observed_at": now,
        }

    num_tools = max(limits["max_distinct_tools"], 1)
    num_profiles = max(limits["max_distinct_profiles"], 1)
    extra = 25
    num_valid = limits["max_retained_event_files"] + extra
    num_distinct_tools = limits["max_distinct_tools"] + 10
    num_distinct_profiles = limits["max_distinct_profiles"] + 10

    def write_valid_batch(start: int, count: int) -> None:
        for i in range(start, start + count):
            event_id = _stress_event_id("evt", i)
            event = make_event(i, num_distinct_tools, num_distinct_profiles)
            _atomic_write_event(events_dir, event_id, event)

    # First, exercise the installed hook through a single valid event.
    hook_command = _find_hook_command(canary)
    if hook_command is None:
        raise RuntimeError("Observation hook not installed in canary")
    _invoke_hook(hook_command, profile_id)

    threads = 4
    per_thread = num_valid // threads
    with concurrent.futures.ThreadPoolExecutor(max_workers=threads) as executor:
        futures = [executor.submit(write_valid_batch, i * per_thread, per_thread) for i in range(threads)]
        for future in concurrent.futures.as_completed(futures):
            future.result()

    # Malformed/rejected event files.
    oversized = events_dir / "oversized.json"
    oversized.write_bytes(os.urandom(limits["max_event_json_bytes"] + 1000))
    os.chmod(oversized, 0o600)

    long_tool_name = "x" * (limits["max_tool_name_length"] + 1)
    long_tool_event = {
        "schema_version": 1,
        "event": "PostToolUse",
        "tool_name": long_tool_name,
        "profile": profile_id,
        "is_background": False,
        "success": True,
        "observed_at": now,
    }
    _atomic_write_event(events_dir, "long-tool", long_tool_event)

    bad_utf8 = events_dir / "bad-utf8.json"
    bad_utf8.write_bytes(b"\xff\xfe" * 16)
    os.chmod(bad_utf8, 0o600)

    not_object = events_dir / "not-object.json"
    not_object.write_text(json.dumps([]), encoding="utf-8")
    os.chmod(not_object, 0o600)

    truncated = events_dir / "truncated.json"
    truncated.write_text('{"schema_version": 1, "event": "PostToolUse"', encoding="utf-8")
    os.chmod(truncated, 0o600)


def _tty_status() -> dict[str, bool]:
    return {
        "stdin": sys.stdin.isatty(),
        "stdout": sys.stdout.isatty(),
        "stderr": sys.stderr.isatty(),
    }


def _cmd_list() -> int:
    print("[]")
    return 0


def _cmd_auth_status() -> int:
    print("Logged in as test-user\nNo credentials recorded by fake-devin.")
    return 0


def _cmd_version() -> int:
    print("devin 0.0.0-fake")
    return 0


def _cmd_help() -> int:
    print("fake-devin: deterministic devin stand-in for the Goal Devin testkit")
    return 0


def _verbose_output() -> None:
    """Write enough bytes to stdout to fill a PTY buffer if the runner is not draining."""
    chunk = b"x" * 4096
    for _ in range(512):
        sys.stdout.buffer.write(chunk)
    sys.stdout.buffer.flush()


def _parse_native_argv(argv: list[str]) -> tuple[str, str]:
    """Parse the native-mode argv strictly.

    Allowed form:
        --model <model> --permission-mode <mode>
    No duplicates, no unknown flags, no positional arguments, no print flags.
    """
    allowed_flags = {"--model", "--permission-mode"}
    forbidden_flags = {"-p", "--print"}
    seen: set[str] = set()
    values: dict[str, str] = {}
    idx = 0
    while idx < len(argv):
        arg = argv[idx]
        if arg in forbidden_flags:
            raise RuntimeError(f"Print mode flag is forbidden: {arg}")
        if arg not in allowed_flags:
            raise RuntimeError(f"Unexpected argument in native-mode argv: {arg}")
        if arg in seen:
            raise RuntimeError(f"Duplicate flag in native-mode argv: {arg}")
        seen.add(arg)
        if idx + 1 >= len(argv):
            raise RuntimeError(f"Missing value for flag: {arg}")
        values[arg] = argv[idx + 1]
        idx += 2
    if "--model" not in values:
        raise RuntimeError("Missing required flag --model")
    if "--permission-mode" not in values:
        raise RuntimeError("Missing required flag --permission-mode")
    return values["--model"], values["--permission-mode"]


def _main() -> int:
    argv = sys.argv[1:]
    if not argv:
        print("fake-devin: no command supplied", file=sys.stderr)
        return 2

    if argv == ["--version"]:
        return _cmd_version()
    if argv == ["--help"]:
        return _cmd_help()
    if argv[:3] == ["list", "--format", "json"] or argv == ["list", "--format=json"]:
        return _cmd_list()
    if argv == ["auth", "status"]:
        return _cmd_auth_status()

    runtime_dir = _load_runtime_dir()
    canary = Path.cwd().resolve()

    model, permission_mode = _parse_native_argv(argv)

    profile_id = _verify_profile(canary, model)
    hook_command = _find_hook_command(canary)
    if hook_command is None:
        raise RuntimeError("Observation hook not installed in canary")

    _verify_existing_hooks_preserved(canary)
    _write_pid(runtime_dir)
    _lifecycle_log("child_start")

    no_poll = os.environ.get("GOAL_DEVIN_FAKE_NO_POLL") in ("1", "true", "yes")
    stress = os.environ.get("GOAL_DEVIN_FAKE_STRESS") in ("1", "true", "yes")
    verbose = os.environ.get("GOAL_DEVIN_FAKE_VERBOSE") in ("1", "true", "yes")
    hang = os.environ.get("GOAL_DEVIN_FAKE_HANG") in ("1", "true", "yes")
    session_start_forged = (
        os.environ.get("GOAL_DEVIN_FAKE_SESSIONSTART_FORGED") in ("1", "true", "yes")
    )
    canonical_flood_raw = os.environ.get("GOAL_DEVIN_FAKE_CANONICAL_FLOOD", "")
    canonical_flood = 0
    if canonical_flood_raw:
        try:
            canonical_flood = int(canonical_flood_raw)
        except ValueError:
            canonical_flood = 0

    if verbose:
        _verbose_output()

    if not no_poll and not stress and not canonical_flood and not session_start_forged:
        _barrier_wait(runtime_dir)

    if canonical_flood:
        _canonical_flood(hook_command, profile_id, canonical_flood)
    elif session_start_forged:
        hook_rc = _invoke_hook(hook_command, profile_id, event_name="SessionStart")
        if hook_rc != 0:
            raise RuntimeError(f"Observation hook exited with code {hook_rc}")
    elif stress:
        limits = _read_limits(runtime_dir) if runtime_dir else {}
        _stress_emit_events(runtime_dir or Path("/dev/null"), canary, profile_id, limits)
    else:
        hook_rc = _invoke_hook(hook_command, profile_id)
        if hook_rc != 0:
            raise RuntimeError(f"Observation hook exited with code {hook_rc}")

    if hang:
        time.sleep(3600)

    sidecar_total_events = 0
    if not no_poll and not stress:
        sleep = float(os.environ.get("GOAL_DEVIN_FAKE_SLEEP", DEFAULT_SLEEP))
        time.sleep(sleep)

        if runtime_dir is not None:
            summary_path = runtime_dir / "summary.json"
            deadline = time.monotonic() + 5
            while time.monotonic() < deadline:
                if summary_path.exists():
                    try:
                        total = json.loads(summary_path.read_text(encoding="utf-8")).get(
                            "total_events", 0
                        )
                        if total >= 1:
                            sidecar_total_events = total
                            break
                    except (json.JSONDecodeError, OSError):
                        pass
                time.sleep(0.05)

    exit_code = int(os.environ.get("GOAL_DEVIN_FAKE_EXIT_CODE", DEFAULT_EXIT_CODE))

    _lifecycle_log("child_end")

    record = {
        "argv": argv,
        "cwd": str(canary),
        "tty": _tty_status(),
        "model": model,
        "permission_mode": permission_mode,
        "profile_id": profile_id,
        "hook_command": hook_command,
        "hook_returncode": 0,
        "sidecar_total_events": sidecar_total_events,
        "exit_code": exit_code,
        "timestamp": _now(),
    }
    _record(runtime_dir, record)
    return exit_code


if __name__ == "__main__":
    try:
        sys.exit(_main())
    except Exception as exc:
        print(f"fake-devin: {exc}", file=sys.stderr)
        sys.exit(1)
