{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "command", "model", "permission_mode", "devin_bin", "canary", "hook_command", "profile_id", "profile_path", "events_dir", "summary_path", "goal_devin_generated", "owned_paths", "owned_roots", "owned_dirs"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "command": { "type": "string" },
    "model": { "type": "string" },
    "permission_mode": { "type": "string" },
    "devin_bin": { "type": "string" },
    "canary": { "type": "string" },
    "hook_command": {
      "type": "array",
      "items": { "type": "string" }
    },
    "profile_id": { "type": "string" },
    "profile_path": { "type": "string" },
    "events_dir": { "type": "string" },
    "summary_path": { "type": "string" },
    "goal_devin_generated": { "type": "boolean", "const": true },
    "owned_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "owned_roots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "owned_dirs": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
